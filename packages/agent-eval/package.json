  },
  "homepage": "https://github.com/CristianPGit/claude-qa-architect/tree/main/packages/agent-eval",
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.137.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "playwright": "^1.64.1",
    "zod": "^4.6.7"
  }
