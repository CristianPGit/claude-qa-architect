  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CristianPGit/claude-qa-architect.git",
    "directory": "packages/self-healing-tests"
  },
  "homepage": "https://github.com/CristianPGit/claude-qa-architect/tree/main/packages/self-healing-tests"
