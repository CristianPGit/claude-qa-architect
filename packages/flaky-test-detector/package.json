{
  "name": "flaky-test-detector",
  "version": "1.0.0",
  "description": "Run your test suite N times and find flaky tests",
  "type": "module",
  "bin": {
    "flaky": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/cli.js",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "flaky",
    "tests",
    "playwright",
    "cypress",
    "jest",
    "vitest",
    "ci",
    "testing"
  ],
  "author": "Cristian Pandele",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CristianPGit/claude-qa-architect.git",
    "directory": "packages/flaky-test-detector"
  },
  "homepage": "https://github.com/CristianPGit/claude-qa-architect/tree/main/packages/flaky-test-detector"
}
