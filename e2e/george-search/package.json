{
  "name": "search-test-scenario",
  "version": "1.0.0",
  "description": "search-test-scenario",
  "main": "index.js",
  "scripts": {
    "test:generate": "bddgen",
    "test:e2e": "bddgen && playwright test",
    "test:login": "bddgen && playwright test --grep @login",
    "test:search": "bddgen && playwright test --grep @search",
    "test:edge-case": "bddgen && playwright test --grep @edge-case",
    "test:smoke": "bddgen && playwright test --grep @smoke",
    "test:tag": "bddgen && playwright test --grep",
    "test:ui": "bddgen && playwright test --ui",
    "test:codegen": "playwright codegen https://george.fat3.sparkasse.at/",
    "report:allure": "allure generate allure-results --clean -o allure-report && allure open allure-report",
    "report:allure:open": "allure open allure-report"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CristianPGit/search-test-scenario.git"
  },
